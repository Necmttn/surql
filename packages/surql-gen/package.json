{
  "name": "@necmttn/surql-schema",
  "version": "1.0.0",
  "description": "Code-first schema management for SurrealDB with Effect integration",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "author": "necmttn",
  "license": "MIT",
  "scripts": {
    "build": "tsc --build",
    "build:bun": "bun build src/index.ts --outdir dist --target node",
    "dev": "bun --watch src/index.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "cli": "bun src/cli/schema-cli.ts",
    "migrate": "bun src/cli/schema-cli.ts migrate",
    "example": "bun src/examples/complete-example.ts",
    "demo": "bun bun-cli.ts demo",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "type-check": "tsc --project tsconfig.cli.json --noEmit || true",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "effect": "^3.10.0",
    "surrealdb": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8",
    "@vitest/ui": "^2.1.8"
  },
  "files": ["src/**/*", "dist/**/*", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "keywords": [
    "surrealdb",
    "schema",
    "code-first",
    "effect",
    "typescript",
    "database",
    "migration",
    "orm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/necmttn/surql-schema.git"
  },
  "bugs": {
    "url": "https://github.com/necmttn/surql-schema/issues"
  },
  "homepage": "https://github.com/necmttn/surql-schema#readme"
}